# CoverLens (apps/insure) runtime env vars. Copy to .env.local for local dev.

# Required for the /api/check policy checker. Without it the route returns 503
# and the rest of the app (upload UI, sample report) still works.
ANTHROPIC_API_KEY=

# Optional. Model id for the checker's drafting node.
# Defaults to claude-sonnet-4-6 when unset.
CHECKER_MODEL=

# Optional. Comma-separated origin allow-list for /api/check. When set (as in
# production), only requests carrying one of these Origins are served. Leave
# unset for local dev and tests, which turns the origin guard off.
# Example: https://coverlens.soonkeong.dev,https://dxxxxxxxxxxxxx.cloudfront.net
ALLOWED_ORIGINS=
